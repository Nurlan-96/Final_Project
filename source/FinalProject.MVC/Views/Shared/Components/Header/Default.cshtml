@model IdentityModule.Response.UserResponse

<div class="container-xxl bg-white p-0">
    <nav class="navbar navbar-expand-lg bg-white navbar-light shadow sticky-top p-0">
        <a asp-action="index" asp-controller="home" class="navbar-brand d-flex align-items-center text-center py-0 px-4 px-lg-5">
            <h1 class="m-0 text-primary">WeWork</h1>
        </a>
        <button type="button" class="navbar-toggler me-4" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto p-4 p-lg-0">
                <a asp-action="index" asp-controller="home" class="nav-item nav-link active">Home</a>
                <a asp-action="index" asp-controller="about" class="nav-item nav-link">About</a>
                <a asp-action="index" asp-controller="contact" class="nav-item nav-link">Contact</a>
            </div>

            @if (Model != null && !string.IsNullOrEmpty(Model.Fullname))
            {
                <a asp-action="index" asp-controller="userprofile" asp-route-id="@Model.Id" class="btn btn-primary rounded-0 py-4 px-lg-5 d-none d-lg-block">
                    @Model.Fullname<i class="fa fa-arrow-right ms-3"></i>
                </a>
            }
            else
            {
                <a asp-action="login" asp-controller="authentication" class="btn btn-primary rounded-0 py-4 px-lg-5 d-none d-lg-block">
                    Login<i class="fa fa-arrow-right ms-3"></i>
                </a>
            }
        </div>
    </nav>
</div>
