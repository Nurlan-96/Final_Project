@using FinalProject.Domain.Constants
@using Job.Module.Commands
@model UpdateCVCommand

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-secondary text-white text-center">
                    <h4>Update CV</h4>
                </div>
                <div class="card-body">
                    <div class="text-danger" asp-validation-summary="ModelOnly"></div>
                    <form method="post">
                        <!-- Full Name -->
                        <div class="mb-3">
                            <label for="fullname" class="form-label">Full Name</label>
                            <input asp-for="Fullname" type="text" class="form-control" placeholder="Enter your full name">
                            <span asp-validation-for="Fullname" class="text-danger"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label for="email" class="form-label">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="mb-3">
                            <label for="phone" class="form-label">Phone Number</label>
                            <input asp-for="PhoneNumber" type="text" class="form-control" placeholder="Enter your phone number">
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <!-- About Me -->
                        <div class="mb-3">
                            <label for="about-me" class="form-label">About Me</label>
                            <textarea asp-for="AboutMe" class="form-control" placeholder="Tell us about yourself"></textarea>
                            <span asp-validation-for="AboutMe" class="text-danger"></span>
                        </div>

                        <!-- Address -->
                        <div class="mb-3">
                            <label for="address" class="form-label">Address</label>
                            <input asp-for="Address" type="text" class="form-control" placeholder="Enter your address">
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <!-- Expected Salary -->
                        <div class="mb-3">
                            <label for="expected-salary" class="form-label">Expected Salary</label>
                            <input asp-for="ExpectedSalary" type="number" class="form-control" placeholder="Enter your expected salary">
                            <span asp-validation-for="ExpectedSalary" class="text-danger"></span>
                        </div>

                        <!-- Education (Enum) -->
                        <div class="mb-3">
                            <label for="education" class="form-label">Education</label>
                            <select asp-for="Education" class="form-select">
                                <option value="">Select your education level</option>
                                @foreach (var education in Enum.GetValues(typeof(EducationEnum)))
                                {
                                    <option value="@education">@education</option>
                                }
                            </select>
                            <span asp-validation-for="Education" class="text-danger"></span>
                        </div>

                        <!-- City (Enum) -->
                        <div class="mb-3">
                            <label for="city" class="form-label">City</label>
                            <select asp-for="City" class="form-select">
                                <option value="">Select your city</option>
                                @foreach (var city in Enum.GetValues(typeof(CityEnum)))
                                {
                                    <option value="@city">@city</option>
                                }
                            </select>
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <!-- Experience (Enum) -->
                        <div class="mb-3">
                            <label for="experience" class="form-label">Experience Level</label>
                            <select asp-for="Experience" class="form-select">
                                <option value="">Select your experience level</option>
                                @foreach (var experience in Enum.GetValues(typeof(ExperienceEnum)))
                                {
                                    <option value="@experience">@experience</option>
                                }
                            </select>
                            <span asp-validation-for="Experience" class="text-danger"></span>
                        </div>

                        <!-- Previous Jobs Section -->
                        <h5 class="mb-3">Previous Jobs</h5>
                        <div id="jobs-container">
                            @if (Model.Jobs != null && Model.Jobs.Any())
                            {
                                @for (var i = 0; i < Model.Jobs.Count; i++)
                                {
                                    <div class="job-item mb-3" id="job-@i">
                                        <div class="mb-2">
                                            <label class="form-label">Job Title</label>
                                            <input type="text" name="Jobs[@i].Name" value="@Model.Jobs[i].Name" class="form-control" placeholder="Enter job title">
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label">Company Name</label>
                                            <input type="text" name="Jobs[@i].CompanyName" value="@Model.Jobs[i].CompanyName" class="form-control" placeholder="Enter company name">
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label">Start Date</label>
                                            <input type="date" name="Jobs[@i].StartDate" value="@Model.Jobs[i].StartDate.ToString("yyyy-MM-dd")" class="form-control">
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label">End Date (Optional)</label>
                                            <input type="date" name="Jobs[@i].EndDate" value="@Model.Jobs[i].EndDate?.ToString("yyyy-MM-dd")" class="form-control">
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label">Description</label>
                                            <textarea name="Jobs[@i].Description" class="form-control" placeholder="Describe your role">@Model.Jobs[i].Description</textarea>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label">City</label>
                                            <select name="Jobs[@i].City" class="form-select">
                                                @foreach (var city in Enum.GetValues(typeof(CityEnum)))
                                                {
                                                    <option value="@city">@city</option>
                                                }
                                            </select>
                                        </div>
                                        <button type="button" class="btn btn-outline-danger remove-job-btn" data-index="@i">Remove Job</button>
                                        <hr>
                                    </div>
                                }
                            }
                        </div>
                        <button type="button" class="btn btn-outline-primary" id="add-job-btn">Add Job</button>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-secondary w-100 mt-4">Update CV</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Link to main.js script -->
<script src="path/to/main.js"></script>
