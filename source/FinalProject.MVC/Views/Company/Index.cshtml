@using FinalProject.Domain.Entities
@model CompanyEntity

<div class="container my-5">
    <div class="row">
        <!-- Company Image -->
        <div class="col-md-4">
            <img src="@Model.Image" alt="@Model.Name" class="img-fluid rounded">
        </div>

        <!-- Company Details -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3>@Model.Name</h3>
                </div>
                <div class="card-body">
                    <!-- Company Description -->
                    <div class="mb-3">
                        <h5>Description</h5>
                        <p>@Model.Description</p>
                    </div>

                    <!-- Contact Information -->
                    <div class="mb-3">
                        <h5>Contact Information</h5>
                        <p><strong>Phone:</strong> @Model.PhoneNumber</p>
                        <p><strong>Email:</strong> <a href="mailto:@Model.Email">@Model.Email</a></p>
                        <p><strong>Address:</strong> @Model.Address</p>
                    </div>
                    <div class="mb-3">
                        <a asp-action="update" asp-controller="company" asp-route-id="@Model.Id" class="btn btn-secondary">Update Your Company</a>
                    </div>
                </div>
            </div>
            <div class="card">
                <h5 class="text-center mb-5">Vacancies by your company</h5>
                <a asp-controller="job" asp-action="createjob" class="btn btn-secondary">Create a vacancy</a>
                <div class="tab-class text-center">
                    <div class="tab-content">
                        @if (ViewBag.Jobs == null)
                        {
                            <p>You have not posted any vacancies yet.</p>
                        }
                        else
                        {
                            foreach (var post in ViewBag.Jobs)
                            {
                                <div class="tab-pane fade show p-0 active">
                                    <div class="job-item p-4 mb-4">
                                        <div class="row g-4">
                                            <div class="col-sm-12 col-md-8 d-flex align-items-center">
                                                <img class="flex-shrink-0 img-fluid border rounded" src="@Model.Image" alt="" style="width: 80px; height: 80px;">
                                                <div class="text-start ps-4">
                                                    <h5 class="mb-3">@post.Name</h5>
                                                    <span class="text-truncate me-3"><i class="fa fa-map-marker-alt text-primary me-2"></i>@post.City</span>
                                                    <span class="text-truncate me-3"><i class="far fa-clock text-primary me-2"></i>@post.EmploymentType</span>
                                                    <span class="text-truncate me-0"><i class="far fa-money-bill-alt text-primary me-2"></i>$@post.Salary</span>
                                                </div>
                                            </div>
                                            <div class="col-sm-12 col-md-4 d-flex flex-column align-items-start align-items-md-end justify-content-center">
                                                <div class="d-flex mb-3">
                                                    <a class="btn btn-light btn-square me-3" href=""><i class="far fa-heart text-primary"></i></a>
                                                    <a class="btn btn-primary" asp-action="apply" asp-controller="job" asp-route-id="@post.Id">Apply Now</a>
                                                </div>
                                                <small class="text-truncate"><i class="far fa-calendar-alt text-primary me-2"></i>@post.ExpirationDate.ToString("dd.MMM.yyyy")</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
