@using Job.Module.Commands
@model CreateReportCommand

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3>Create a Report</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <!-- Report Reason -->
                        <div class="mb-3">
                            <label for="reason" class="form-label">Reason for Report</label>
                            <textarea asp-for="Reason" class="form-control" placeholder="Enter the reason for reporting"></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>

                        <!-- Job Post ID -->
                        <div class="mb-3">
                            <label for="job-post-id" class="form-label">Job Post ID</label>
                            <input asp-for="JobPostId" type="number" class="form-control" placeholder="Enter the Job Post ID">
                            <span asp-validation-for="JobPostId" class="text-danger"></span>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary w-100">Submit Report</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
